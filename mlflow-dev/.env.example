# Copy to .env and change EVERY value. .env is gitignored — never commit real secrets.

# --- PostgreSQL backend store ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mlflow

# Artifacts are stored on a local Docker volume (served via MLflow proxy),
# so no S3/MinIO credentials are needed for the dev server.
# When you move to a shared deployment with blob storage, add the S3 vars here
# (see mlflow-dev/README.md "Scaling to blob storage").
