# ============================================================
#  Copy this file to  .env   then paste your REAL key.
#    PowerShell:   copy .env.example .env
#  .env is gitignored and will NEVER be committed. Do not share it.
# ============================================================
#
#  Use ONE provider. Groq has a FREE tier (no card): https://console.groq.com
#
#  IMPORTANT when pasting the key:
#    - put the WHOLE key on one line, right after the  =  (no spaces)
#    - no quotes, no line breaks in the middle
#    - a real Groq key starts with  gsk_  and is ~56 characters long
#    - use the console's "Copy" button so you don't truncate it

# ---- Groq (free tier, recommended) ----
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_FULL_GROQ_KEY
GROQ_MODEL=openai/gpt-oss-20b

# ---- OpenAI (only if the account has billing credits) ----
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# OPENAI_MODEL=gpt-4o-mini

# RAG settings
RAG_TOP_K=3
