# Copy this file to `.env` (same folder) and paste your real key.
# `.env` is gitignored and will NEVER be committed. Do not share it.
#
# Set ONE provider. Groq has a free tier (no card): https://console.groq.com

# --- Option A: Groq (free tier, recommended) ---
GROQ_API_KEY=gsk-your-real-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option B: OpenAI (needs billing credits) ---
# OPENAI_API_KEY=sk-your-real-key-here
# OPENAI_MODEL=gpt-4o-mini

# RAG settings
RAG_TOP_K=3
