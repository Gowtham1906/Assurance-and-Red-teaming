{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-4/redteam-case/1.0.0",
  "title": "Capability 4 red-team case (plan section 9.2)",
  "type": "object",
  "required": ["id", "title", "version", "category", "taxonomy", "target_type",
               "turns", "expected_safe_behaviour", "detection", "default_severity",
               "pass_criteria", "safety_handling", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^rt-[0-9]{3}(-[a-z0-9-]+)?$"},
    "title": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "category": {"type": "string", "enum": [
      "direct_injection", "indirect_injection", "system_prompt_leakage",
      "sensitive_data_disclosure", "cross_user_leakage", "vector_poisoning",
      "jailbreak", "harmful_content", "misinformation", "excessive_agency",
      "resource_exhaustion", "multilingual"]},
    "taxonomy": {
      "type": "object",
      "required": ["owasp_llm", "atlas_version", "atlas_ids", "nist_term"],
      "properties": {
        "owasp_llm": {"type": "array", "items": {"type": "string", "pattern": "^LLM(0[1-9]|10)$"}},
        "owasp_asi": {"type": "array", "items": {"type": "string", "pattern": "^ASI(0[1-9]|10)$"}},
        "atlas_version": {"type": "string"},
        "atlas_ids": {"type": "array", "items": {"type": "string", "pattern": "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$"}},
        "nist_term": {"type": "string", "enum": ["evasion", "poisoning", "privacy", "misuse"]}
      }
    },
    "target_type": {"type": "string", "enum": ["rag", "agent"]},
    "setup": {
      "type": "object",
      "properties": {
        "persona": {"type": "object"},
        "fixtures": {"type": "array", "items": {"type": "string"}},
        "tools_enabled": {"type": "array", "items": {"type": "string"}},
        "initial_state": {"type": "object"}
      }
    },
    "turns": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["role", "content"],
      "properties": {"role": {"type": "string", "enum": ["user", "document", "tool"]},
                     "content": {"type": "string"}}}},
    "payload_ref": {"type": "string"},
    "variants": {"type": "array", "items": {"type": "object"}},
    "expected_safe_behaviour": {"type": "string"},
    "detection": {
      "type": "object", "required": ["checks"],
      "properties": {"checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                     "judge_rubric": {"type": "string"}}
    },
    "default_severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
    "pass_criteria": {
      "type": "object", "required": ["runs", "min_pass"],
      "properties": {"runs": {"type": "integer", "minimum": 1},
                     "min_pass": {"type": "integer", "minimum": 1}}
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "safety_handling": {"type": "string"},
    "provenance": {
      "type": "object", "required": ["source", "date_added"],
      "properties": {"source": {"type": "string"}, "date_added": {"type": "string"},
                     "last_reviewed": {"type": "string"}}
    }
  }
}
